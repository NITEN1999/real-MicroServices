        {
            "name": "Auth Service",
            "item": [
                {
                    "name": "1. Register User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.data && jsonData.data.register) {",
                                    "    pm.collectionVariables.set('AUTH_TOKEN', jsonData.data.register.token);",
                                    "    pm.collectionVariables.set('REFRESH_TOKEN', jsonData.data.register.refreshToken);",
                                    "    console.log('Token saved!');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"mutation { register(input: { email: \\\"john@example.com\\\", password: \\\"password123\\\" }) { token refreshToken user { id email role isActive createdAt } } }\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{GATEWAY_URL}}",
                            "host": [
                                "{{GATEWAY_URL}}"
                            ]
                        }
                    }
                },
                {
                    "name": "2. Login User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.data && jsonData.data.login) {",
                                    "    pm.collectionVariables.set('AUTH_TOKEN', jsonData.data.login.token);",
                                    "    pm.collectionVariables.set('REFRESH_TOKEN', jsonData.data.login.refreshToken);",
                                    "    console.log('Token saved!');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"mutation { login(input: { email: \\\"john@example.com\\\", password: \\\"password123\\\" }) { token refreshToken user { id email role isActive lastLogin createdAt } } }\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{GATEWAY_URL}}",
                            "host": [
                                "{{GATEWAY_URL}}"
                            ]
                        }
                    }
                },
                {
                    "name": "3. Get Current User (me)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{AUTH_TOKEN}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"query { me { id email role isActive lastLogin createdAt updatedAt } }\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{GATEWAY_URL}}",
                            "host": [
                                "{{GATEWAY_URL}}"
                            ]
                        }
                    }
                },
                {
                    "name": "4. Verify Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"query { verifyToken(token: \\\"{{AUTH_TOKEN}}\\\") { id email role isActive } }\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{GATEWAY_URL}}",
                            "host": [
                                "{{GATEWAY_URL}}"
                            ]
                        }
                    }
                },
                {
                    "name": "5. Refresh Token",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.data && jsonData.data.refreshToken) {",
                                    "    pm.collectionVariables.set('AUTH_TOKEN', jsonData.data.refreshToken.token);",
                                    "    pm.collectionVariables.set('REFRESH_TOKEN', jsonData.data.refreshToken.refreshToken);",
                                    "    console.log('New tokens saved!');",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"mutation { refreshToken(refreshToken: \\\"{{REFRESH_TOKEN}}\\\") { token refreshToken user { id email role } } }\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{GATEWAY_URL}}",
                            "host": [
                                "{{GATEWAY_URL}}"
                            ]
                        }
                    }
                },
                {
                    "name": "6. Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{AUTH_TOKEN}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"mutation { logout { success message } }\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{GATEWAY_URL}}",
                            "host": [
                                "{{GATEWAY_URL}}"
                            ]
                        }
                    }
                }
            ]
        },
