{
    "info": {
        "_postman_id": "microservices-arch-001",
        "name": "Microservices Architecture",
        "description": "Complete collection for testing GraphQL microservices.\n\n1. Run Register or Login first\n2. Copy the token from response\n3. Paste in AUTH_TOKEN variable\n4. All other requests use it automatically",
