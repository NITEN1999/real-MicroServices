            "key": "GATEWAY_URL",
            "value": "http://localhost:4001/graphql"
        },
        {
            "key": "AUTH_TOKEN",
            "value": "paste-your-token-here"
        },
        {
            "key": "REFRESH_TOKEN",
            "value": "paste-your-refresh-token-here"
        }
    ],
